# Copy this file to .env and replace every secret before deployment.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=sentinel_db
JWT_SECRET=change-this-long-random-jwt-secret

# Public browser URL of the gateway. Use the server hostname or IP.
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:8080

# Host ports. Change these if another service already uses them.
GATEWAY_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
PROMETHEUS_PORT=9090
MOBILE_PORT=8081
RABBITMQ_USER=sentinel
RABBITMQ_PASSWORD=change-this-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Mobile app public gateway URL. Android emulator normally uses 10.0.2.2;
# a physical device needs the server LAN IP or DNS name.
EXPO_PUBLIC_API_URL=http://YOUR_SERVER_IP:8080

# Optional: pin an existing tenant UUID.
# TENANT_ID=