services:
  postgres:
    image: postgres:16-alpine
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./database/init/001_init.sql:/docker-entrypoint-initdb.d/001_init.sql:ro
      - ./database/migrations/0001_initial.sql:/docker-entrypoint-initdb.d/010_initial.sql:ro
      - ./database/migrations/0002_rbac.sql:/docker-entrypoint-initdb.d/020_rbac.sql:ro
      - ./database/migrations/0003_core_xdr.sql:/docker-entrypoint-initdb.d/030_core_xdr.sql:ro
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-sentinel}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set in .env}
      POSTGRES_DB: ${POSTGRES_DB:-sentinel_db}
    ports:
      - "${POSTGRES_PORT:-5432}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-sentinel} -d ${POSTGRES_DB:-sentinel_db}"]
      interval: 5s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    ports:
      - "${REDIS_PORT:-6379}:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5

  rabbitmq:
    image: rabbitmq:3-management-alpine
    environment:
      RABBITMQ_DEFAULT_USER: ${RABBITMQ_USER:-sentinel}
      RABBITMQ_DEFAULT_PASS: ${RABBITMQ_PASSWORD:-sentinel}
    ports:
      - "${RABBITMQ_PORT:-5672}:5672"
      - "${RABBITMQ_MANAGEMENT_PORT:-15672}:15672"
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10

  ml-inference:
    build:
      context: ./ml-inference
    container_name: sentinel-ml-inference
    environment:
      MODEL_PATH: /app/models/model.onnx
      FEATURE_DIM: "256"
      RUST_LOG: info
    volumes:
      - ./ml-inference/models:/app/models:ro
    expose:
      - "5000"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:5000/health"]
      interval: 15s
      timeout: 3s
      retries: 5

  detection-service:
    build:
      context: ./backend/detection-service
    container_name: sentinel-detection-service
    depends_on:
      ml-inference:
        condition: service_healthy
    environment:
      PORT: "8090"
      ML_API_URL: http://ml-inference:5000
      ML_TIMEOUT_SECS: "5"
      RULE_THRESHOLD: "0.70"
      RUST_LOG: info
    ports:
      - "8090:8090"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8090/health"]
      interval: 15s
      timeout: 3s
      retries: 5

  gateway:
    build:
      context: ./backend
      dockerfile: gateway/Dockerfile
    ports:
      - "${GATEWAY_PORT:-8080}:8080"
    environment:
      DATABASE_URL: postgres://${POSTGRES_USER:-sentinel}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-sentinel_db}
      JWT_SECRET: ${JWT_SECRET:?JWT_SECRET must be set in .env}
      REDIS_URL: redis://redis:6379
      RABBITMQ_URL: amqp://${RABBITMQ_USER:-sentinel}:${RABBITMQ_PASSWORD:-sentinel}@rabbitmq:5672/%2f
      TENANT_ID: ${TENANT_ID:-}
      DETECTION_SERVICE_URL: http://detection-service:8090
      DETECTION_SERVICE_TIMEOUT_SECS: "3"
      BIND_ADDRESS: "0.0.0.0:8080"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      detection-service:
        condition: service_started

  frontend:
    build:
      context: ./frontend
      args:
        NEXT_PUBLIC_API_URL: ${NEXT_PUBLIC_API_URL:-http://localhost:${GATEWAY_PORT:-8080}}
    ports:
      - "${FRONTEND_PORT:-3000}:3000"
    depends_on:
      - gateway

  mobile:
    build:
      context: ./mobile
      args:
        EXPO_PUBLIC_API_URL: ${EXPO_PUBLIC_API_URL:-http://10.0.2.2:${GATEWAY_PORT:-8080}}
    container_name: sentinel-mobile
    ports:
      - "${MOBILE_PORT:-8081}:8081"
    depends_on:
      - gateway

  prometheus:
    image: prom/prometheus:latest
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml
    ports:
      - "${PROMETHEUS_PORT:-9090}:9090"
    depends_on:
      - gateway

volumes:
  postgres_data:
